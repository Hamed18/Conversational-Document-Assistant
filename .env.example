# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Distributed Model Fallback Chain (Prioritized by Latency & Quality)
MODEL_PRIMARY=google/gemini-2.5-flash
MODEL_FALLBACK_1=qwen/qwen-2.5-72b-instruct
MODEL_FALLBACK_2=nvidia/nemotron-3-super-120b-a12b:free
MODEL_FALLBACK_CHAIN=google/gemini-2.5-flash,qwen/qwen-2.5-72b-instruct,nvidia/nemotron-3-super-120b-a12b:free

# Compatible OpenAI settings (pointing to OpenRouter)
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=docs

# Inngest Cloud Configuration
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# Neon PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-round-unit.region.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET_KEY=your_64_char_hex_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

