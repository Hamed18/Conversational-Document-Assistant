# Replace your-domain.com with your domain, or use :80 for plain HTTP / IP access
# Example:
# rag.yourdomain.com {
#     reverse_proxy frontend:8501
# }
# inngest.yourdomain.com {
#     reverse_proxy inngest:8288
# }

:80 {
    # Route /inngest and /inngest/* to the Inngest Observability Dashboard
    handle /inngest* {
        reverse_proxy inngest:8288
    }

    # All other traffic routes to Streamlit Chat UI
    handle {
        reverse_proxy frontend:8501
    }
}
